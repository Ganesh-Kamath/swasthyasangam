# SwasthyaSangam Deployment & Cross-Device Configuration
# Note: Netlify server-side functions handle temporary session storage.

# 1. Netlify Deployment Token (for automated deployment from dev environment)
# NETLIFY_AUTH_TOKEN=your_token_here

# 2. Optional: Explicit deployed URL (auto-derived from browser origin if omitted)
# VITE_PUBLIC_APP_URL=https://swasthyasangam.netlify.app
